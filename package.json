{
  "name": "openexpense.org",
  "version": "2.1.0",
  "private": false,
  "description": "Privacy-first, offline-only expense tracker. The ledger never leaves the browser.",
  "license": "MIT",
  "homepage": "https://www.openexpense.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghadow1/openexpense.org.git"
  },
  "bugs": {
    "url": "https://github.com/ghadow1/openexpense.org/issues"
  },
  "keywords": [
    "expense-tracker",
    "privacy",
    "offline",
    "indexeddb",
    "aes-gcm",
    "pwa"
  ],
  "scripts": {
    "build": "npx esbuild src/main.js --bundle --format=esm --minify --target=es2020 --splitting --outdir=. --entry-names=app --chunk-names=chunk-[hash]",
    "serve": "python3 -m http.server 8765",
    "test": "node --test scripts/qc-ledger-file.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8"
  }
}
