{
  "name": "openexpense.org",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/clean-build-assets.mjs",
    "build": "npx esbuild src/main.js --bundle --format=esm --minify --target=es2020 --splitting --outdir=. --entry-names=app --chunk-names=chunk-[hash]",
    "build:watch": "node scripts/clean-build-assets.mjs && npx esbuild src/main.js --bundle --format=esm --target=es2020 --splitting --outdir=. --entry-names=app --chunk-names=chunk-[hash] --watch",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm test && npm run build",
    "serve": "python3 -m http.server 8765"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8"
  }
}
